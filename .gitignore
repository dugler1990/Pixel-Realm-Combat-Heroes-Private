# Runtime debug log output (see Code/debug_logging.schema.md)
Code/logs/*.log

# py-spy multiplayer profiling output (tools/profile_mp.sh)
profiles/

# ── Regenerable dev cruft ──────────────────────────────
__pycache__/
*.pyc
Code/sprite_venv/
logs/

# ── Generated-art pipeline: default-deny allowlist ─────
# Ignore everything the pipeline emits; re-include ONLY real assets
# and the small manifests that describe them. New junk is ignored
# automatically. To track a NEW asset type, add one '!' line.
generated/painted/**
!generated/painted/**/
!generated/painted/**/painted.png
!generated/painted/**/*_manifest.json
!generated/painted/**/metadata.json

levels/Frostreach/expanse/export/**
!levels/Frostreach/expanse/export/**/
!levels/Frostreach/expanse/export/painted_4k_leonardo/*.png
!levels/Frostreach/expanse/export/collision_leonardo/*.png
!levels/Frostreach/expanse/export/sam3_obstacle/**/polygons.json
!levels/Frostreach/expanse/export/**/*_manifest.json
!levels/Frostreach/expanse/export/**/*_summary.json

# ── World-levels pipeline: none of it belongs in git ───
# Everything under here is pipeline working state -- jobs, retries, canvases, masks,
# and the accepted art itself. The deliverable is the level directory the art ends up
# in, not the machinery that produced it. Keep accepted/ backed up OUTSIDE the repo:
# it is what the generations were paid for and it cannot be rebuilt for free.
generated/world_levels/**

# ── Painted-map art: managed outside git ──────────────────────────────────────
# The map art is hundreds of MB per level and git keeps every version of it forever,
# so none of it lives here -- including the images the .tmx files point at. A fresh
# clone therefore has the levels but not their art, and needs it restored from the
# asset store before those levels will render.
#
# The .tmx, .tsx and the small config sidecars stay tracked: they are the level, and
# they are text.
levels/*/*/generated_bootstrap/
levels/*/*/background*.png
levels/*/*/export/**/*.png

# Scratch renders that collect in the repo root while iterating.
/*.png


# Shadow level folders the interior pipeline writes plans into. Symlinks to the real
# level's art plus a map.tmx carrying the traced geometry; the shipped map is only
# written on accept.
levels/*/*.plan/
